generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // 런타임(앱): 커넥션 풀러 경유(Supabase는 6543 포트, ?pgbouncer=true). 로컬은 다이렉트와 동일.
  url       = env("DATABASE_URL")
  // 마이그레이션/introspection: 풀러를 우회한 다이렉트 연결(Supabase는 5432). 로컬은 DATABASE_URL과 동일.
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  PART_LEADER
  SETTLEMENT
  PM
}

enum UserStatus {
  PENDING
  ACTIVE
  INACTIVE
}

enum TaskSource {
  MANUAL
  PDF
}

enum ExpenseCategory {
  CORPORATE_CARD
  PERSONAL_CARD
  LABOR_COUNSELOR
  LABOR_INSTRUCTOR
  EDUCATION_PROGRAM
  PROMOTION_OFFLINE
  PROMOTION_EVENT
  OPS_TRANSPORT
  OPS_LODGING
  OPS_FOOD
  OPS_MEETING
  TEST_MATERIAL
  GENERAL_ETC
}

enum PayeeType {
  INSTRUCTOR // 강사 (주민등록번호 13자리, keyId a###)
  VENDOR     // 업체 (사업자등록번호 10자리, keyId b###)
}

enum TaxType {
  TAX_INVOICE         // 세금계산서
  TAX_FREE_INVOICE    // 면세계산서
  CASH_RECEIPT        // 현금영수증
  HANDWRITTEN_INVOICE // 수기계산서
  BUSINESS_INCOME     // 사업소득
  OTHER_INCOME        // 기타소득
}

enum PayeeFileType {
  BIZ_CERT // 사업자등록증
  BANKBOOK // 통장사본
}

enum PaymentRequestEntity {
  HUNO       // 휴노
  HUNO_INC   // 휴노INC
}

enum PaymentRequestStatus {
  PREPARING  // 지급준비 (기본값)
  COMPLETED  // 지급완료
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  name      String?
  image     String?
  emailVerified DateTime? // Auth.js Prisma 어댑터 필수 필드
  role      Role?
  status    UserStatus @default(PENDING)
  teamId    String?    // 소속 팀. 팀 관리자·PM의 접근 범위 기준. SUPER_ADMIN/SETTLEMENT는 무관.
  team      Team?      @relation(fields: [teamId], references: [id], onDelete: SetNull)
  // 소속 파트장. PM에게 의미가 있다(자신을 지정한 파트장이 담당 고객사를 열람·관리). 파트장 접근 범위는
  // 별도 필드 없이 담당 PM(ClientManager→User.partLeaderId)에서 도출한다. 팀(teamId)의 하위 스코프.
  partLeaderId String?
  partLeader   User?  @relation("PartMembers", fields: [partLeaderId], references: [id], onDelete: SetNull)
  partMembers  User[] @relation("PartMembers")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  managedClients ClientManager[]
  managedProjects ProjectManager[]
  paymentRequests PaymentRequest[]
  accounts  Account[]
  sessions  Session[]

  @@index([role])
  @@index([status])
  @@index([teamId])
  @@index([partLeaderId])
}

// 팀. 팀 관리자(ADMIN)와 PM이 소속되며, 팀 관리자는 자기 팀 소속 PM이 담당하는
// 고객사만 열람한다. 고객사의 팀 귀속은 별도 필드 없이 담당 PM(ClientManager)에서 도출한다.
model Team {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members   User[]
}

model Client {
  id           String   @id @default(cuid())
  name         String
  status       String   @default("진행중")
  industry     String?
  businessType String?  // 사업자 구분: 휴노 | 휴노INC
  hyundaiEasywel Boolean @default(false) // 현대이지웰 소개로 계약한 고객사
  deletedAt    DateTime? // 소프트 삭제(보관). null=활성, 값=보관됨(목록에서 숨김).
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // 청구·보고 주기, 계약기간, 실적계약 여부, 과업은 Project 계층으로 이동했다.
  managers     ClientManager[]
  projects     Project[]
  tasks        Task[]
  billings     MonthlyBilling[]
  deposits     MonthlyDeposit[]
  expenses     Expense[]
  consultingExpenses ConsultingExpense[]
  corporateCardExpenses CorporateCardExpense[]
  paymentRequests PaymentRequest[]
}

// 고객사 아래의 프로젝트(계약). 청구·보고 주기, 계약기간, 담당 PM, 과업을 소유한다.
// 재무 데이터(청구·입금·지출·성과)는 고객사 단위로 유지하고, 프로젝트 기준 집계 시
// 프로젝트 계약기간(contractStart~contractEnd) 월범위로 잘라 귀속한다.
model Project {
  id                  String    @id @default(cuid())
  clientId            String
  client              Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name                String
  status              String    @default("진행중")
  contractStart       DateTime?
  contractEnd         DateTime?
  billingCycle        String[]  @default([]) // 청구 주기(복수): 월/분기/중간/최종
  reportCycle         String[]  @default([]) // 보고 주기(복수): 월/분기/중간/최종
  performanceContract Boolean   @default(false) // 실적 계약 여부.
  deletedAt           DateTime? // 소프트 삭제(보관).
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  managers            ProjectManager[]
  tasks               Task[]

  @@index([clientId])
}

// 프로젝트–담당PM 다대다 조인. 표시·설정용. 접근 권한(RLS)은 여전히 ClientManager 기준이며,
// 프로젝트 PM 배정 시 앱이 ClientManager를 프로젝트 PM들의 합집합으로 동기화한다.
model ProjectManager {
  projectId String
  userId    String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
}

// 고객사–담당PM 다대다 조인. 한 고객사에 여러 PM을 지정할 수 있다.
model ClientManager {
  clientId String
  userId   String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([clientId, userId])
  @@index([userId])
}

model Task {
  id             String     @id @default(cuid())
  clientId       String     // 비정규화: RLS·고객사 단위 집계용. 항상 project.clientId와 동일.
  client         Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId      String
  project        Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name           String
  unitPrice      Int
  contractCount  Int?
  contractAmount Int?
  vatExempt      Boolean    @default(false) // 면세 여부(기본: 과세). true면 부가세 토글 무시.
  source         TaskSource @default(MANUAL)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  performances   MonthlyPerformance[]

  @@index([clientId])
  @@index([projectId])
}

model MonthlyPerformance {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  year      Int
  month     Int
  count     Float?
  amount    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([taskId, year, month])
  @@index([year, month])
}

model MonthlyBilling {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  year      Int
  month     Int
  amount    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, year, month])
  @@index([year, month])
}

model MonthlyDeposit {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  year      Int
  month     Int
  amount    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, year, month])
  @@index([year, month])
}

model Expense {
  id        String          @id @default(cuid())
  clientId  String
  client    Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  year      Int
  month     Int
  category  ExpenseCategory
  amount    Int
  memo      String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([clientId, year, month, category])
  @@index([clientId, year, month])
}

// 상담비 라인아이템. 상담분야(field)를 세부 항목 구분 기준으로 삼는다.
// 엑셀(상담료 지출내역) 적재용. 집계형 Expense와 별개의 상세 원장.
model ConsultingExpense {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientName  String   // 고객사명(Client.name와 동일값). 엑셀 기업명은 매칭에만 쓰고 저장은 정식 고객사명으로.
  field       String   // 상담분야 — 세부 항목 구분 기준
  consultType String?  // 상담유형(참고용)
  sessionDate String?  // 실시일시 — 엑셀 '실시일시'의 날짜부분만 'YYYY-MM-DD' 문자열로 저장(시각 제외)
  year        Int      // 지급월(연)
  month       Int      // 지급월(월)
  amount      Int?     // 지급비용(선택). 현재 적재분은 저장하지 않아 null.
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([clientId, year, month])
  @@index([field])
}

// 법인카드 사용 내역 라인아이템. 항목(item)을 세부 구분 기준으로 삼는다.
// 엑셀(법인카드 사용 내역) 적재용. 집계형 Expense와 별개의 상세 원장.
model CorporateCardExpense {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientName  String   // 고객사명(Client.name와 동일값). 엑셀 프로젝트명은 매칭에만 쓰고 저장은 정식 고객사명으로.
  item        String   // 항목 — 세부 구분 기준(교통/숙박/기타 등)
  year        Int      // 이용일(연)
  month       Int      // 이용일(월)
  amount      Int      // 매입금액(지출금액)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([clientId, year, month])
  @@index([item])
}

// 지급 대상 원장(공용). 정산담당자/관리자가 엑셀로 업로드. 민감정보는 앱 계층 암호화.
model Payee {
  id                  String    @id @default(cuid())
  keyId               String    @unique // 표시 고유번호 a001/b001 (앱이 시퀀스로 채번)
  payeeType           PayeeType          // 강사/업체 (번호 길이로 파생)
  bizName             String             // 사업자명/이름
  bizNumberEnc        String             // 사업자번호/주민번호 AES-GCM 암호문
  bizNumberMasked     String             // 마스킹 표시값 (900101-1****** / 123-45-6****)
  bizNumberBidx       String    @unique  // HMAC 블라인드 인덱스 (정확일치 검색 + 중복 방지)
  phone               String             // 강사·업체 공통 연락처
  phoneNormalized     String             // 하이픈 제거 검색용 (앱이 채움)
  bankName            String
  accountNumberEnc    String             // 계좌번호 AES-GCM 암호문
  accountNumberMasked String             // ****1234
  accountNumberBidx   String             // HMAC 블라인드 인덱스 (정확일치 검색용, unique 아님 — 공동명의 등으로 계좌번호가 겹칠 수 있어 사업자명과 함께 비교)
  accountHolder       String             // 예금주
  taxType             TaxType            // 청구방식
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?          // 소프트 삭제. null=활성, 값=삭제됨(목록에서 숨김).

  attachments         PayeeAttachment[]
  paymentRequests     PaymentRequest[]

  @@index([phoneNormalized])
  @@index([payeeType])
  @@index([accountNumberBidx])
}

// 지급 대상 첨부(사업자등록증/통장사본).
model PayeeAttachment {
  id         String        @id @default(cuid())
  payeeId    String
  payee      Payee         @relation(fields: [payeeId], references: [id], onDelete: Cascade)
  fileType   PayeeFileType
  fileUrl    String
  fileName   String
  uploadedAt DateTime      @default(now())

  @@unique([payeeId, fileType])
  @@index([payeeId])
}

// PM이 강사/업체 지급을 요청하는 건별 레코드. Payee(마스터 정보)와는 느슨하게 연결—
// 지급 리스트에서 선택한 건은 payeeId로 연동, 지급 리스트에 없는 예외 건은 payeeId를 비우고
// bizName만 텍스트로 저장한다.
model PaymentRequest {
  id            String                @id @default(cuid())
  seqNo         Int                   @unique @default(autoincrement()) // 영구 고정 채번(No) — Payee.keyId처럼 등록 시 한 번 정해지고 이후 바뀌지 않음
  requestedAt   DateTime              @default(now())   // 신청일 (자동)
  requesterId   String?                                  // 신청인. 신청인 계정 하드 삭제 시 NULL(레코드는 보존).
  requester     User?                 @relation(fields: [requesterId], references: [id], onDelete: SetNull)
  entity        PaymentRequestEntity                     // 지급명의
  clientId      String                                   // 고객사
  client        Client                @relation(fields: [clientId], references: [id])
  payeeId       String?                                  // 지급 리스트 연동(있으면 FK)
  payee         Payee?                @relation(fields: [payeeId], references: [id])
  bizName       String                                   // 사업자명(이름) 스냅샷
  bankName      String                                   // 은행명 스냅샷(매칭 건=Payee 값, 예외 건=엑셀 입력값)
  accountNumberEnc String                                // 계좌번호 스냅샷(AES-GCM 암호문, Payee.accountNumberEnc와 동일 방식)
  accountHolder String                                   // 예금주 스냅샷
  unitPrice     Int                                       // 단가
  transportFee  Int                                       // 교통비
  materialFee   Int                                       // 재료비
  count         Int                                       // 횟수
  amount        Int                                       // 지급액 = (단가+교통비+재료비)×횟수
  taxType       TaxType                                   // 청구방식
  memo          String                                    // 상세내역(비고)
  payDate       DateTime?                                 // 지급일 — 정산담당자가 이후 채움
  status        PaymentRequestStatus  @default(PREPARING) // 지급여부
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  deletedAt     DateTime?                                 // 소프트 삭제

  @@index([clientId])
  @@index([requesterId])
  @@index([status])
  @@index([payeeId])
}

// 지급요청 탭 상단 공지 배너. 항상 최대 1행("singleton")만 존재 — 새로 저장하면 덮어쓴다.
// 작성자/작성일시는 요구사항상 저장하지 않는다.
model PaymentRequestNotice {
  id        String   @id @default("singleton")
  content   String   @default("")
  updatedAt DateTime @updatedAt
}

// --- Auth.js (NextAuth) 어댑터 모델 ---
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
